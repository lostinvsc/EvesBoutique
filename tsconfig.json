{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",       // ✅ Add this
    "paths": { 
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
"include": [
  "next-env.d.ts",
  ".next/types/**/*.ts",
  ".next/types/**/*.js",
  ".next/types/**/*.jsx",
  ".next/types/**/*.tsx",
  "**/*.ts",
  "**/*.tsx",
  "**/*.jsx",
  "**/*.js"
],
  "exclude": [
    "node_modules"
  ]
}